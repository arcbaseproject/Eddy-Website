---
import Base from './Base.astro';

// Markdown pages pass their props as `frontmatter`; .astro pages pass them directly.
const { title, description } = Astro.props.frontmatter ?? Astro.props;
---
<Base title={title} description={description}>
  <main class="wrap legal"><slot /></main>
</Base>

<style>
  .legal { max-width: 720px; padding-block: 48px 96px; color: var(--muted); }
  .legal :global(h1) { font-size: clamp(34px, 5vw, 44px); line-height: 1.1; letter-spacing: -.03em; color: var(--ink); margin-bottom: 8px; }
  .legal :global(h2) { font-size: 22px; color: var(--ink); margin: 40px 0 12px; }
  .legal :global(p), .legal :global(ul), .legal :global(ol) { margin: 0 0 16px; }
  .legal :global(li) { margin-bottom: 6px; }
  .legal :global(a) { color: var(--blue); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .legal :global(strong) { color: var(--ink); }
  .legal :global(img) { display: block; width: 260px; max-width: 100%; height: auto; margin: 24px 0; border-radius: 24px; border: 5px solid var(--surface); box-shadow: var(--shadow); }
  .legal :global(blockquote) { margin: 24px 0; padding: 20px 24px; border-radius: 28px; background: var(--tile-sky); color: var(--ink); }
  .legal :global(blockquote > :last-child) { margin-bottom: 0; }
  .legal :global(code) { font-size: .9em; overflow-wrap: anywhere; }
</style>
