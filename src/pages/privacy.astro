---
import Base from '../layouts/Base.astro';
import { Content } from '../content/PRIVACY.md';
---
<Base title="Privacy Policy | Eddy Browser" description="Eddy collects no personal data: no accounts, ads, analytics or crash reports. See what stays on your device and which network requests Eddy makes.">
  <main class="wrap legal"><Content /></main>
</Base>

<style>
  .legal { max-width: 720px; padding-block: 48px 96px; color: var(--muted); }
  .legal :global(h1) { font-size: clamp(34px, 5vw, 44px); line-height: 1.1; letter-spacing: -.03em; color: var(--ink); margin-bottom: 8px; }
  .legal :global(h2) { font-size: 22px; color: var(--ink); margin: 40px 0 12px; }
  .legal :global(p), .legal :global(ul) { margin: 0 0 16px; }
  .legal :global(li) { margin-bottom: 6px; }
  .legal :global(a) { color: var(--blue); text-underline-offset: 3px; }
  .legal :global(strong) { color: var(--ink); }
</style>
